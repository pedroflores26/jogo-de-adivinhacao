<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="28dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎲"
            android:textSize="52sp"
            android:layout_marginTop="25dp" />

        <TextView
            android:id="@+id/txtBoasVindas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Olá!"
            android:textSize="23sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="12dp" />

        <TextView
            android:id="@+id/txtTentativas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tentativas: 0"
            android:textSize="17sp"
            android:layout_marginTop="18dp" />

        <EditText
            android:id="@+id/edtPalpite"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Seu palpite"
            android:inputType="number"
            android:gravity="center"
            android:textSize="22sp"
            android:padding="14dp"
            android:layout_marginTop="28dp" />

        <Button
            android:id="@+id/btnChutar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CHUTAR"
            android:textStyle="bold"
            android:layout_marginTop="14dp"
            android:padding="14dp" />

        <TextView
            android:id="@+id/txtDica"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Faça seu primeiro palpite."
            android:textSize="19sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="22dp"
            android:layout_marginTop="22dp" />

        <Button
            android:id="@+id/btnJogarNovamente"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="JOGAR DE NOVO"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            android:padding="14dp"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
